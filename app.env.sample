# LimeSurvey - Environment Variables
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Host settings
BASE_HOST_NAME=limesurvey.example.com
BASE_DOMAIN_NAME=example.com

# Database (MariaDB)
DB_CREATE_DATABASE_NAME=limesurvey
DB_USER_NAME=limesurvey
DB_USER_PASS=changeme_db_password
DB_ADMIN_PASS=changeme_admin_password

# Admin account
APP_ADMIN_USER=admin
APP_ADMIN_PASS=changeme_admin_password
APP_ORG_NAME=LimeSurvey
